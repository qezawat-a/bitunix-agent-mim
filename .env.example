# LLM Settings
# AI_PROVIDER: AUTO (use every key that is present) | openai | anthropic | google
AI_PROVIDER=AUTO

# OpenAI-compatible (OpenAI, DeepSeek, Groq, Ollama, and any OpenAI-compatible
# gateway such as an aggregator). *_MODEL=AUTO means autoSetModelByKey: read
# <URL>/models, probe the models in the order the provider returned them, and
# keep the first one this key can actually use. A model this key is denied — or
# rate-limited on (HTTP 429) — is skipped in favour of the next one the
# provider listed. Older AI_API_KEY / AI_BASE_URL / AI_MODEL still work.
OPENAI_COMPATIBLE_KEY=
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBALE_MODEL=AUTO

# Anthropic. BASE_URL is accepted as a fallback for ANTHROPIC_BASE_URL.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=AUTO

# Google (Gemini). GEMINI_API_KEY / GEMINI_BASE_URL / GEMINI_MODEL still work.
GEMINI_GOOGLE_KEY=
GEMINI_GOOGLE_URL=
GEMINI_GOOGLE_MODEL=AUTO

# AUTO model behaviour
# With AI_MODEL=AUTO the agent reads the models from <AI_BASE_URL>/models using
# the key above, probes them in the order the provider returned them, and uses the
# first one that works with that key. A model the key is denied, or rate-limited
# on, is skipped for the next one from that same list. There is no fallback list
# of model names and nothing is cached on disk. Set AI_MODEL to a name only to pin
# that exact model.
#   AI_AUTO_REFRESH=1   re-read the provider's list once AI_MODEL_TTL expires
#   AI_MODEL_TTL=ms     how long a resolved model stays valid (default 10 min)
AI_AUTO_REFRESH=0
AI_MODEL_TTL=600000

# BituniX
BITUNIX_API_KEY=
BITUNIX_API_SECRET=
BITUNIX_BASE_URL=https://fapi.bitunix.com
BITUNIX_WS_PUBLIC=wss://fapi.bitunix.com/public/
BITUNIX_WS_PRIVATE=wss://fapi.bitunix.com/private/

# Database Neon. Leave DATABASE_URL empty to fall back to the local data/ file.
DATABASE_URL=
# Set DATABASE_SSL=false for a local Postgres that has no TLS.
DATABASE_SSL=true
# Keep this true for Neon; only turn it off for a proxy with its own certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Telegram Bot
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=
# MINI_APP_URL is only needed if you want the Telegram menu button to open the
# web app. Leave it unset and the bot works normally without it.

# Agent Configuration
AGENT_NAME=J-ROCK
# The agent looks at each new signal by itself. Turn it off and it only
# acts when you ask it to in chat.
AGENT_AUTONOMOUS=1
AGENT_MAX_STEP=8
AGENT_THINKING_ENABLED=true
AGENT_THINKING_LEVEL=mid
AGENT_THINKING_BUDGET=5000
# How often the agent checks for something new to react to. It is nudged once
# per new signal, not once per tick.
AGENT_AUTONOMOUS_INTERVAL_SEC=15

# Trader Configuration
timeframes=1m,3m,5m,15m,1h
# order_unit: cost | qty | position_size
# cost: Cost Value percentage of available balance; leverage affects quantity
# position_size: Nominal Value percentage of available balance; leverage-independent
# qty: Quantity Value; supply an explicit base-asset quantity per order
order_unit=cost
margin_amount_pct=2
position_sizing_margin_pct=2
